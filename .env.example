# Postgres for the API. On Vercel, set this in the project's environment
# variables (a Neon integration sets it for you); locally, `cargo run --bin dev`
# reads it from .env. Neon's pooled and direct connection strings both work.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require

# The key Aero shows once when Champt registers for Login with Aero: a
# k4.local.… string that decrypts sign-in tokens. Backend only (on Vercel, a
# project environment variable); never commit it. Without it the API still
# serves reads but refuses every sign-in.
# AERO_LOGIN_KEY=k4.local.…

# Where `cargo run --bin dev` listens. Vite proxies /api here.
# LISTEN=127.0.0.1:8787

# Only for `cargo test`: a throwaway database the integration tests write to.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require
